{
  "manifest_version": 3,
  "name": "Talaan spike (other, attacker)",
  "version": "0.0.1",
  "key": "",
  "host_permissions": [
    "http://localhost:3100/*",
    "http://localhost:8100/*"
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      }
    }
  }
}
