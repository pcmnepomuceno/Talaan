# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres container (docker-compose) ---
POSTGRES_USER=talaan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=talaan
POSTGRES_PORT=5432

# --- Application database connection ---
# The password here MUST match POSTGRES_PASSWORD above.
# Host is "localhost" when running the API on your machine,
# or the compose service name ("db") when the API also runs in Docker.
DATABASE_URL=postgresql+psycopg2://talaan:change-me@localhost:5432/talaan

# --- Tests ---
# Must point at a database whose name ends in _test (create it once:
# docker compose exec db createdb -U talaan talaan_test).
TEST_DATABASE_URL=postgresql+psycopg2://talaan:change-me@localhost:5432/talaan_test

# --- Password hashing ---
# bcrypt cost for new hashes and the login dummy hash. Keep 12 in production;
# the test suite sets 4 for speed. Must be 4-31; below 12 logs a warning at startup.
BCRYPT_ROUNDS=12

# --- Rate limiting (login and signup; counters live in Postgres) ---
# Login: attempts per IP, and failed attempts per email, within the window.
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW_SECONDS=900
LOGIN_EMAIL_LIMIT=5
LOGIN_EMAIL_WINDOW_SECONDS=900
# Signup: attempts per IP.
SIGNUP_IP_LIMIT=5
SIGNUP_IP_WINDOW_SECONDS=3600
# Account deletion: password attempts per user, and attempts per IP.
ACCOUNT_DELETE_USER_LIMIT=5
ACCOUNT_DELETE_USER_WINDOW_SECONDS=900
ACCOUNT_DELETE_IP_LIMIT=10
ACCOUNT_DELETE_IP_WINDOW_SECONDS=900
# true only behind a proxy you control: uses the right-most X-Forwarded-For value.
# Leave false otherwise, or clients can spoof their IP. Run uvicorn with --no-proxy-headers.
# Not useful behind Vercel + Render (the right-most hop is a shared Vercel address): use PROXY_SECRET.
TRUST_PROXY=false
# Shared secret with the Next proxy (frontend PROXY_SECRET, same value, at least 32 characters:
# openssl rand -hex 32). Only a request carrying it in X-Talaan-Proxy-Secret may name the client
# IP in X-Talaan-Client-IP; this is what gives each visitor their own rate-limit bucket behind
# Vercel. Blank = those headers are ignored (local work).
PROXY_SECRET=

# --- Environment ---
# development (default) or production. Production hides /docs, /redoc, /openapi.json and refuses
# to start unless COOKIE_SECURE is true, ALLOWED_ORIGINS lists only non-local https origins,
# PROXY_SECRET is set and BCRYPT_ROUNDS >= 12.
ENVIRONMENT=development

# --- Session cookie ---
# Set COOKIE_SECURE=false in your local .env for plain http; the default true is for production.
# Unset (the default) is true: the cookie is Secure and named __Host-session_token. A plain-http
# client (curl, Safari on http://localhost) will not send a Secure cookie back.
# COOKIE_SECURE=false

# --- CSRF: allowed browser origins ---
# Comma-separated exact origins, each scheme://host[:port] with no path (no wildcard;
# blank = http://localhost:3000; a malformed entry fails startup). A state-changing
# request whose Origin header is not listed gets 403; requests without Origin (curl) pass.
# In production list the frontend's origin, e.g. https://talaan.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
